import {
  "mizchi/wite/component" @wite_component,
  "mizchi/wite/config" @wite_config,
  "mizchi/wite/deps" @wite_deps,
  "mizchi/wite/bundle" @wite_bundle,
  "mizchi/wite/analyze" @wite_analyze,
  "mizchi/wite/optimize" @wite_optimize,
  "mizchi/wite/core" @wite_core,
  "mizchi/wit",
  "mizchi/x/http" @xhttp,
  "mizchi/x/process" @xprocess,
  "mizchi/x/fs" @xfs,
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/core/random",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  targets: {
    "dev_e2e_wbtest.mbt": [ "js" ],
    "e2e_analyze_wbtest.mbt": [ "js" ],
    "main_wbtest.mbt": [ "js" ],
    "workerd_e2e_wbtest.mbt": [ "js" ],
    "workerd_wbtest.mbt": [ "js" ],
  },
